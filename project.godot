; Engine configuration file.
; Math Invaders (Godot Edition)
; See Tech Stack §1 and Phase 0 doc §3 for the settings below.

config_version=5

[application]

config/name="Math Invaders"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.03137255, 0.0392157, 0.10980392, 1)
config/icon="res://icon.svg"

; NOTE (Phase 0 §2, Architecture Ownership): GameManager.gd and
; HighScoreManager.gd are reserved as autoloads/singletons per the fixed
; architecture boundary, but neither has real logic until Phase 4
; (health/lives/game-over) and Phase 6 (high score persistence)
; respectively. They are intentionally NOT registered here yet so that
; Phases 0-3 don't carry dead autoload code; Phase 4's doc is expected to
; add the [autoload] entries when GameManager.gd gains real behavior.

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
